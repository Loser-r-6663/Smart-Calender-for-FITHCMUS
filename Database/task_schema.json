{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-calendar.local/schemas/task.schema.json",
  "title": "Task",
  "description": "JSON Schema for task payloads accepted by the Smart Calendar API.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S",
      "description": "Unique task ID."
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "type": {
      "type": "string",
      "enum": ["class", "assignment", "exam", "event", "personal", "tuition"]
    },
    "course": {
      "type": ["string", "null"],
      "minLength": 1,
      "default": null
    },
    "description": {
      "type": ["string", "null"],
      "default": null
    },
    "target_audience": {
      "type": ["string", "null"],
      "minLength": 1,
      "default": null
    },
    "location": {
      "type": ["string", "null"],
      "minLength": 1,
      "default": null
    },
    "registration_start": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "registration_end": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "start_time": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "end_time": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "deadline": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "estimated_hours": {
      "type": ["number", "null"],
      "minimum": 0.25,
      "maximum": 40,
      "default": null
    },
    "training_points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "drl_category": {
      "type": ["string", "null"],
      "enum": ["dieu_1", "dieu_2", "dieu_3", "dieu_4", "dieu_5", null],
      "default": null
    },
    "recurrence": {
      "type": ["string", "null"],
      "maxLength": 50,
      "pattern": "^(T[2-7]|CN) ((?:[01][0-9]|2[0-3]):[0-5][0-9])-((?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "default": null,
      "description": "One recurring weekday and time range in 24-hour format, e.g. T2 08:00-10:00. Weekdays: T2-T7 or CN."
    },
    "status": {
      "type": "string",
      "enum": ["active", "done", "archived", "cancelled"],
      "default": "active"
    },
    "is_manual": {
      "type": "boolean",
      "default": false
    },
    "source_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://",
      "default": null
    },
    "source_platform": {
      "type": "string",
      "enum": ["moodle", "portal", "facebook", "custom"],
      "default": "custom"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Defaults to the current UTC time when omitted."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {"enum": ["assignment", "tuition"]}
        },
        "required": ["type"]
      },
      "then": {
        "required": ["deadline"],
        "properties": {
          "deadline": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "training_points": {"type": "integer", "minimum": 1}
        },
        "required": ["training_points"]
      },
      "then": {
        "properties": {
          "drl_category": {
            "type": "string",
            "enum": ["dieu_1", "dieu_2", "dieu_3", "dieu_4", "dieu_5"]
          }
        }
      }
    }
  ],
  "x-validation-rules": [
    "All non-null datetime fields must include a timezone offset.",
    "registration_start must be earlier than registration_end when both are set.",
    "start_time must be earlier than end_time when both are set.",
    "Recurrence must specify one weekday (T2-T7 or CN) and a 24-hour time range.",
    "The recurrence start time must be earlier than its end time.",
    "If training_points is greater than 0 and drl_category is omitted or null, the API assigns dieu_3."
  ]
}
