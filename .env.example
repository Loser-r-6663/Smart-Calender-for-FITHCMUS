# Copy this file to .env for actual use. The application reads process env only.
# Default provider preserves existing Gemini behavior.
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI-compatible Chat Completions
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini #Placeholder
OPENAI_RESPONSE_FORMAT=json_object
# Compatible local servers may use a placeholder key if their harness requires
# the Authorization header, for example http://localhost:8000/v1.
