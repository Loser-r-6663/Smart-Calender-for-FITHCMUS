# Copy this file to .env for actual use. The application reads process env only.
# Default provider preserves existing Gemini behavior.
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI-compatible Chat Completions
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESPONSE_FORMAT=json_object
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_MAX_INPUT_CHARS=30000
OPENAI_RETRIES=2
OPENAI_TEMPERATURE=0.0
OPENAI_OUTPUT_RETRIES=1
OPENAI_LENGTH_RETRY_TOKENS=8192

# Task REST API
DATABASE_API_URL=http://127.0.0.1:8000
DATABASE_API_TIMEOUT_SECONDS=10
DATABASE_API_KEY=your_database_api_key_here
