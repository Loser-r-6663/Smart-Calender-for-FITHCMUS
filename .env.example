# Copy this file to .env for local use. Never commit the populated .env file.

# Crawler credentials (Backend/Crawler/PortalCrawler.py)
# The portal and Facebook crawlers use these only when an interactive login is needed.
PORTAL_USERNAME=your_portal_username_here
PORTAL_PASSWORD=your_portal_password_here
FB_USERNAME=your_facebook_username_here
FB_PASSWORD=your_facebook_password_here

# Parser provider selection (Backend/Parser/providers.py)
# Gemini currently reads only these two values from the environment. Its timeout,
# retry, temperature, input limit, and 8192 output-token defaults are code-defined.
#LLM_PROVIDER=openai_compatible
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI-compatible Chat Completions, basically any other API AI provider goes here: (Backend/Parser/providers.py)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESPONSE_FORMAT=json_object
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_MAX_INPUT_CHARS=30000
OPENAI_RETRIES=2
OPENAI_TEMPERATURE=0.0
OPENAI_OUTPUT_RETRIES=1
OPENAI_LENGTH_RETRY_TOKENS=8192

# Parser state and Database API client (Backend/Parser)
PARSER_DEDUP_STATE_PATH=.parser-dedup.json
DATABASE_API_URL=http://127.0.0.1:8000
DATABASE_API_TIMEOUT_SECONDS=10
# Use either ADMIN_API_KEY or LLM_API_KEY depending on permissions.
DATABASE_API_KEY=your_database_api_key_here

# PostgreSQL (Database/db_config.py and Database/db_connection.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_manager_db
DB_USER=your_postgres_username_here
DB_PASSWORD=your_postgres_password_here

# Database API authorization (Database/role_permissions.json)
# These must be distinct, random secrets. Do not reuse either provider key.
ADMIN_API_KEY=your_admin_api_key_here
LLM_API_KEY=your_llm_api_key_here
