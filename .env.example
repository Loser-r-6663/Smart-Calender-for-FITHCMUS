# Shared Supabase endpoint and public client configuration.
SUPABASE_URL = https://your-project.supabase.co
SUPABASE_PUBLIC_KEY = replace-with-your-public-client-key

# Crawler service key. Keep it out of client configuration.
SUPABASE_SECRET_KEY =
# Private runtime settings for encrypted account data and crawling.
SUPABASE_ENCRYPTION_KEY =
GEMINI_API_KEY =
FB_USERNAME =
FB_PASSWORD =
APP_ROLE = LOCAL

# Web client configuration.
CLIENT_MODE = mock
CLIENT_HOST = 127.0.0.1
CLIENT_PORT = 8080
CLIENT_STORAGE_SECRET = replace-with-a-long-random-value

# Shared durable owner store for NiceGUI and the scheduler (repository-relative or absolute).
LOCAL_TASK_DB_DIR = Database/data
